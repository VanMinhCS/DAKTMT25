{
  "_comment_secrets": "=== SECRETS được quản lý trong file .env (xem .env.example) ===",

  "model_path": "models/yolo/plant_disease_v4.pt",
  "confidence_threshold": 0.65,
  "inference_imgsz": 480,
  "camera_width": 640,
  "camera_height": 480,
  "camera_id": 0,
  "rtsp_stream_name": "mystream",
  "show_fps": true,

  "send_interval_seconds": 10,
  "current_version": "v1.0",

  "_comment_flags": "=== FEATURE FLAGS — đặt true/false để bật tắt từng khối ===",
  "enable_camera":  true,
  "enable_sensor":  true,
  "enable_mqtt":    true,
  "enable_streamer": true,
  "enable_lstm":    true,

  "_comment_lstm": "=== LSTM CONFIG ===",
  "lstm_model_path":   "models/lstm/potato_health_lstm.h5",
  "lstm_scaler_path":  "models/lstm/potato_scaler.pkl",
  "lstm_encoder_path": "models/lstm/potato_encoder.pkl",
  "lstm_window_size":  12,

  "_comment_defaults": "=== Giá trị mặc định (đơn vị gốc) khi sensor không gửi đủ 7 feature ===",
  "lstm_default_soil_moisture":    72.0,
  "lstm_default_soil_temperature": 18.0,
  "lstm_default_ec":             1200.0,
  "lstm_default_ph":                6.0,
  "lstm_default_nitrogen":         60.0,
  "lstm_default_phosphorus":       40.0,
  "lstm_default_potassium":       160.0
}