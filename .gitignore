# Source models (nặng, chỉ giữ local)
models/yolo/*.pt              
models/lstm/*.keras
models/lstm/*.h5

# ── Dataset (quá nặng để commit, lưu trên Drive/Kaggle) ──
data/*.csv
data/*.parquet

