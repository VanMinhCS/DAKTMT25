    qemu_binary="PSEUDO_UNLOAD=1 qemu-arm -r 3.2.0  -L $STAGING_DIR_HOST -E LD_LIBRARY_PATH=$STAGING_DIR_HOST//usr/lib:$STAGING_DIR_HOST//lib "
