    if test -f $f; then mv $f $backupdir; restore=mv; else :; fi; \
  done; \
else :; fi && \
cd "$am__cwd"; \
if /bin/bash '/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/autoconf-native/2.71-r0/autoconf-2.71/build-aux/missing' makeinfo --no-split  -I doc -I ../autoconf-2.71/doc \
