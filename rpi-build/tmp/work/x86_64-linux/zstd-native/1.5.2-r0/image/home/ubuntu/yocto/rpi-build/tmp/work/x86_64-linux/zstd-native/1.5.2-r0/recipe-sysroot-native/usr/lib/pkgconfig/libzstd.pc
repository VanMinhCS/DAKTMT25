prefix=/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/zstd-native/1.5.2-r0/recipe-sysroot-native/usr
exec_prefix=/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/zstd-native/1.5.2-r0/recipe-sysroot-native/usr
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: zstd
Description: fast lossless compression algorithm library
URL: http://www.zstd.net/
Version: 1.5.2
Libs: -L${libdir} -lzstd
Libs.private: -pthread
Cflags: -I${includedir}
