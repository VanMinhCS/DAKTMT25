# line: 101, file: /home/ubuntu/yocto/poky/meta/recipes-core/ncurses/ncurses.inc
do_configure() {
	#Remove /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/recipe-sysroot-native/usr/include from CPPFLAGS, need for cross compile
	sed -i 's#-I${cf_includedir}##g' /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/git/configure || die "sed CPPFLAGS"

	# The --enable-pc-files requires PKG_CONFIG_LIBDIR existed
	mkdir -p /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/recipe-sysroot-native/usr/lib/pkgconfig
	( cd /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/git; gnu-configize --force )
	ncurses_configure "narrowc" || \
		return 1
	! true || \
		ncurses_configure "widec" "--enable-widec" "--without-progs"
}

# line: 48, file: /home/ubuntu/yocto/poky/meta/classes/base.bbclass
die() {
	bbfatal_log "$*"
}

# line: 69, file: /home/ubuntu/yocto/poky/meta/recipes-core/ncurses/ncurses.inc
ncurses_configure() {
	mkdir -p $1
	cd $1
	shift
	oe_runconf \
	        --without-debug \
	        --without-ada \
	        --without-gpm \
	        --enable-hard-tabs \
	        --enable-xmc-glitch \
	        --enable-colorfgbg \
	        --with-termpath='/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/recipe-sysroot-native/etc/termcap:/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/recipe-sysroot-native/usr/share/misc/termcap:/etc/termcap:/usr/share/misc/termcap' \
	        --with-terminfo-dirs='/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/recipe-sysroot-native/etc/terminfo:/home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/ncurses-native/6.3+20220423-r0/recipe-sysroot-native/usr/share/terminfo:/etc/terminfo:/usr/share/terminfo:/usr/share/misc/terminfo:/lib/terminfo' \
	        --with-shared \
	        --disable-big-core \
	        --program-prefix= \
	        --with-ticlib \
	        --with-termlib=tinfo \
	        --enable-sigwinch \
	        --enable-pc-files \
	        --disable-rpath-hack \
		 		--disable-lp64 		--with-chtype='long' 		--with-mmask-t='long' --without-normal \
	        --with-manpage-format=normal \
	        --without-manpage-renames \
	        --disable-stripping \
	        "$@" || return 1
	cd ..
}

