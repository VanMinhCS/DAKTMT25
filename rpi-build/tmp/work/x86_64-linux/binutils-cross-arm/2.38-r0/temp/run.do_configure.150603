# line: 124, file: /home/ubuntu/yocto/poky/meta/recipes-devtools/binutils/binutils.inc
do_configure() {
	(cd /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/binutils-cross-arm/2.38-r0/git && gnu-configize)

	oe_runconf
#
# must prime config.cache to ensure the build of libiberty
#
	mkdir -p /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/binutils-cross-arm/2.38-r0/git/build.x86_64-linux.arm-poky-linux-gnueabi/build-x86_64-linux
	for i in /home/ubuntu/yocto/poky/meta/site/endian-little /home/ubuntu/yocto/poky/meta/site/common-linux /home/ubuntu/yocto/poky/meta/site/common-glibc /home/ubuntu/yocto/poky/meta/site/x86_64-linux /home/ubuntu/yocto/poky/meta/site/common; do
		cat $i >> /home/ubuntu/yocto/rpi-build/tmp/work/x86_64-linux/binutils-cross-arm/2.38-r0/git/build.x86_64-linux.arm-poky-linux-gnueabi/build-x86_64-linux/config.cache || true
	done
}

