# line: 44, file: /home/ubuntu/yocto/poky/meta/recipes-devtools/pseudo/pseudo.inc
maybe_make32() {
	# We probably don't need to build 32-bit binaries.
	make32=false
	if [ "64" = "64" ]; then
		case "1" in
		0)	make32=true
			;;
		1)	make32=false
			;;
		*)	# If unset, build 32-bit if we think we can.
			if [ -e "/usr/include/gnu/stubs-32.h" ]; then
				make32=true
			fi
			;;
		esac
	fi
	if $make32; then
		if ! [ -e "/usr/include/gnu/stubs-32.h" ]; then
			warn_32bit_missing
		else
			bbnote "Attempting to build 32-bit libpseudo.so for pseudo-native."
		fi
	else
		bbnote "Building/installing only 64-bit libpseudo.so for pseudo-native."
		bbnote "If you need to run 32-bit executables, ensure that NO32LIBS is set to 0."
	fi
}

