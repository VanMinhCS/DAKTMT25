# ============================================================
# .env.example — TEMPLATE an toàn để commit lên Git
# Sao chép file này thành .env rồi điền giá trị thật vào
# ============================================================

# ThingsBoard / CoreIoT
THINGSBOARD_HOST=your-thingsboard-host.com
THINGSBOARD_ACCESS_TOKEN=your_device_access_token_here

# Device Identity
DEVICE_ID=your-device-id
PLANT_ID=your-plant-id

# Firebase Cloud Upload (Optional if enable_cloud_upload is true)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_BUCKET=your_project_id.appspot.com
