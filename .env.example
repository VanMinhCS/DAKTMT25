# ThingsBoard / CoreIoT
THINGSBOARD_HOST=your-thingsboard-host.com
THINGSBOARD_ACCESS_TOKEN=your_device_access_token_here

# Device Identity
DEVICE_ID=your-device-id
PLANT_ID=your-plant-id

